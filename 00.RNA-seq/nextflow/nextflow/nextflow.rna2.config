process {
    executor = 'local'
    errorStrategy = 'retry'
    maxRetries = 1

    withName: 'h5_prepare_1' { cpus = 2; memory = '8 GB';  maxForks = 8 }
    withName: 'h5_prepare_2' { cpus = 4; memory = '32 GB'; maxForks = 1 }
    withName: 'WASP_find'    { cpus = 2; memory = '16 GB'; maxForks = 8 }
    withName: 'WASP_remap'   { cpus = 8; memory = '40 GB'; maxForks = 4 }
    withName: 'WASP_dedup'   { cpus = 2; memory = '12 GB'; maxForks = 4 }
    withName: 'leafcutter'   { cpus = 2; memory = '8 GB';  maxForks = 4 }
    withName: 'phaser_snp'   { cpus = 8; memory = '16 GB'; maxForks = 4 }
    withName: 'phaser_gene'  { cpus = 1; memory = '4 GB';  maxForks = 8 }
}

executor {
    name = 'local'
    cpus = 48
    memory = '384 GB'
}

conda.enabled = false

trace {
    enabled = true
    file = 'rna2.trace.txt'
    fields = 'task_id,hash,name,status,exit,realtime,cpus,%cpu,peak_rss,peak_vmem'
}