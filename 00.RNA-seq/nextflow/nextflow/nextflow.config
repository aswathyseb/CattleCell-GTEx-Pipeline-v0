/*
process {
    executor = 'local'
    errorStrategy = 'retry'
}
*/

process {
    executor = 'local'
    errorStrategy = 'retry'
    maxRetries = 1
    // Default slot for the lighter steps (fastp, counts, StringTie, HTSeq).
    cpus = 2
    memory = '8 GB'

    withName: 'FASTP' {
        cpus = 4
        memory = '4 GB'
    }
    withName: 'STAR' {
        cpus = 8
        memory = '32 GB'
        maxForks = 2
    }
    withName: 'Salmon' {
        cpus = 4
        memory = '8 GB'
        maxForks = 2
    }
    withName: 'BQSR' {
        cpus = 4
        memory = '24 GB'
        maxForks = 2
    }
    withName: 'LNCRNA' {
        cpus = 4
        memory = '8 GB'
        maxForks = 4
    }
}

// Plato has 96 cores and 1 TiB, and it is a shared machine. This run may
// use 24 cores and 192 GB at once: two STAR alignments plus either two
// Salmon or two BQSR jobs. That is enough to keep the 170-sample queue
// moving without taking the host.
executor {
    name = 'local'
    cpus = 24
    memory = '192 GB'
}

conda.enabled = false

//conda.enabled = false makes Nextflow ignore those hardcoded conda prefixes.
// The tasks then use whatever is on PATH, so start Nextflow only after micromamba activate nf-cattlegtex.

